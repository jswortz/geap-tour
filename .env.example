GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_STAGING_BUCKET=your-project-id-geap-staging

# MCP server URLs (set after deploying to Cloud Run)
SEARCH_MCP_URL=https://search-mcp-xxx-uc.a.run.app/mcp
BOOKING_MCP_URL=https://booking-mcp-xxx-uc.a.run.app/mcp
EXPENSE_MCP_URL=https://expense-mcp-xxx-uc.a.run.app/mcp

# Agent Gateway — regional for Agent Runtime, global for Gemini Enterprise
AGENT_GATEWAY_PATH=projects/your-project-id/locations/us-central1/agentGateways/geap-workshop-gateway
AGENT_GATEWAY_EGRESS_PATH=projects/your-project-id/locations/us-central1/agentGateways/geap-workshop-gateway-egress

# Model Armor templates
MODEL_ARMOR_PROMPT_TEMPLATE=projects/your-project-id/locations/us-central1/templates/geap-workshop-prompt
MODEL_ARMOR_RESPONSE_TEMPLATE=projects/your-project-id/locations/us-central1/templates/geap-workshop-response

# Agent Engine IDs (set after deploying agents)
AGENT_ENGINE_ID=your-coordinator-engine-id
ROUTER_ENGINE_ID=your-router-engine-id

# Multi-model router
LITE_MODEL=gemini-2.0-flash-lite
FLASH_MODEL=gemini-2.5-flash
OPUS_MODEL=vertex_ai/claude-opus-4-7
COMPLEXITY_THRESHOLD_HIGH=0.65
CLASSIFIER_MODEL=gemini-2.0-flash-lite

# --- Gemini Enterprise: Router Cost Visualizer (A2UI app) ---
# GE engine (Gemini Enterprise app / Discovery Engine engine) to publish the A2UI agent into.
GEMINI_ENTERPRISE_PROJECT=your-project-id
GEMINI_ENTERPRISE_LOCATION=global
GEMINI_ENTERPRISE_ENGINE_ID=your-gemini-enterprise-engine-id
# Set after the first registration to update the agent in place (else a new one is created).
GEMINI_ENTERPRISE_AGENT_ID=
# Cloud Run service that hosts the A2A/A2UI agent card.
ROUTER_UI_SERVICE=geap-router-cost-ui
ROUTER_UI_REGION=us-east1
ROUTER_UI_APP_URL=https://geap-router-cost-ui-PROJECT_NUMBER.us-east1.run.app
A2A_APP_NAME=app

# --- Gemini Enterprise: publish the two ADK agents DIRECTLY (reasoning engines) ---
# Used by scripts/publish_agents_to_ge.py and scripts/publish_agents_to_ge.sh. These register the
# coordinator + router reasoning engines to the GE app above via adkAgentDefinition (no Cloud Run
# wrapper). Engine IDs are resolved live by display name if unset; set to pin them explicitly.
# COORDINATOR_ENGINE_ID falls back to AGENT_ENGINE_ID (the id deploy_agents.py writes).
COORDINATOR_ENGINE_ID=
# ROUTER_ENGINE_ID is shared with the Agent Runtime config above.
# See docs/publishing_agents_to_gemini_enterprise.md
